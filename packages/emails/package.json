	},
	"devDependencies": {
		"@carrismetropolitana/eslint": "20250622.1204.50",
		"@react-email/preview-server": "5.1.1",
		"@types/node": "25.0.3",
		"resolve-tspaths": "0.8.23",
		"typescript": "5.9.3"
	}
}
