{
	"name": "@spginecologia/website-emails",
	"version": "1.0.0",
	"private": true,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc && resolve-tspaths",
