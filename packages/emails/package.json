	},
	"devDependencies": {
		"@carrismetropolitana/eslint": "20250622.1204.50",
		"@react-email/preview-server": "4.2.9",
		"@types/node": "24.3.1",
		"resolve-tspaths": "0.8.23",
		"typescript": "5.9.2"
	}
}
