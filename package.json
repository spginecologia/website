{
	"name": "@spginecologia/website",
	"version": "1.0.0",
	"keywords": [],
	"main": "index.js",
	"scripts": {
		"build": "turbo build",
		"build:packages": "turbo build --filter=./packages/*",
		"dev": "npm run build:packages && dotenv-run -f ./environments/development/secrets/.env -- turbo dev",
		"dev:prod": "dotenv-run -f ./environments/production/secrets/.env -- turbo dev",
		"lint": "turbo lint",
		"lint:fix": "eslint . --fix && npx stylelint . --fix",
		"rinse": "npx --yes @tmlmobilidade/repo-rinse",
		"start": "turbo start"
	},
	"devDependencies": {
		"@carrismetropolitana/eslint": "20250622.1204.50",
		"@dotenv-run/cli": "1.3.6",
		"turbo": "2.6.3",
		"typescript": "5.9.3"
	},
	"packageManager": "npm@11.7.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
