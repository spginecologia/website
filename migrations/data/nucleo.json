    {
        "id": 335,
        "date": "2021-07-20T01:10:31",
        "date_gmt": "2021-07-20T00:10:31",
        "guid": {
            "rendered": "https://spginecologia.pt/?post_type=nucleo&#038;p=335"
        },
        "modified": "2021-10-14T18:07:08",
        "modified_gmt": "2021-10-14T17:07:08",
        "slug": "estudos-clinicos",
        "status": "publish",
        "type": "nucleo",
        "link": "https://spginecologia.pt/nucleo/estudos-clinicos/",
        "title": {
            "rendered": "Estudos Clínicos"
        },
        "featured_media": 134,
        "template": "",
        "class_list": [
            "post-335",
            "nucleo",
            "type-nucleo",
            "status-publish",
            "has-post-thumbnail",
            "hentry"
        ],
        "acf": {
            "seccao_mission": "Promover e facilitar a realização de estudos",
            "seccao_subheader_1": {
                "seccao_subheader_1_title": "O nosso projeto",
                "seccao_subheader_1_text": "O Núcleo de Estudos Clínicos (NEC), foi criado em 2017, com o objetivo de promover e facilitar a realização de estudos de índole nacional. Cumprindo a finalidade estabelecida na sua constituição, foi iniciado, nesse mesmo ano, um projeto de criação de bases de dados digitais para registo e armazenamento de intervenções na área da ginecologia (GinBase). No futuro, para além da recolha e armazenamento da informação, pretende-se constituir um polo de apoio à preparação de estudos científicos, em particular na vertente da análise estatística especializada. Estão neste momento criadas, e ativas, três bases de dados de estudos clínicos: “Redes e Complicações” em Uroginecologia; “Agenesias müllerianas”; “Adesão e resultados da monitorização hepática, em doentes sob acetato de ulipristal”."
            },
            "seccao_subheader_2": {
                "seccao_subheader_2_title": "A nossa acção",
                "seccao_subheader_2_text": "Participar nestes registos é dar cumprimento às recomendações da Comissão Europeia e do seu Scientific Committee on Emerging and Newly Identified Health Risks (SCENIHR) sobre monitorização da segurança das redes em Uroginecologia. A representatividade dos resultados depende do número de participantes pelo que se apela à colaboração de todos os hospitais, públicos e privados.\r\n\r\nOs colegas interessados em integrar este projeto podem contactar o NEC para o endereço estudosclinicos@spginecologia.pt"
            },
