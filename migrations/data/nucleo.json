        "acf": {
            "seccao_mission": "Um exame que não apresenta quaisquer riscos ou complicações",
            "seccao_subheader_1": {
                "seccao_subheader_1_title": "O nosso projeto",
                "seccao_subheader_1_text": "A criação do Núcleo de Ecografia Ginecológica surge da necessidade de representar e acompanhar a franca evolução e abrangência desta área. Estamos perante uma tecnologia cada vez mais sofisticada, com desenvolvimento de novas técnicas com auxílio ecográfico e evolução do conhecimento científico em diferentes áreas de aplicabilidade da ecografia. A endometriose, as disfunções do pavimento pélvico e a avaliação da doença oncológica ginecológica são alguns dos exemplos."
            },
            "seccao_subheader_2": {
                "seccao_subheader_2_title": "A nossa acção",
                "seccao_subheader_2_text": "Desenvolver/promover acções de formação nacionais e internacionais (cursos, reuniões e palestras com participação de especialistas internacionais em reuniões da especialidade) sobre ecografia ginecológica. Assim como a divulgação de artigos científicos e a divulgação dos consensos de interesse em ecografia ginecológica."
            },
